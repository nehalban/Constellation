{
  "manifest_version": 3,
  "name": "Constellation",
  "version": "2.1",
  "description": "Say goodbye to guessing. Link real names to CP handles across multiple platforms and track friends' ratings, synced across devices.",
  "permissions": [ "storage", "activeTab" ],
  "content_scripts": [
    {
      "matches": [ 
        "*://codeforces.com/*", 
        "*://*.codeforces.com/*", 
        "*://atcoder.jp/*",
        "*://leetcode.com/*",
        "*://*.leetcode.com/*",
        "*://hackerrank.com/*",
        "*://*.hackerrank.com/*",
        "*://kaggle.com/*",
        "*://*.kaggle.com/*",
        "*://geeksforgeeks.org/*",
        "*://*.geeksforgeeks.org/*"
      ],
      "js": [ "src/content/content.js" ]
    }
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/images/logo_icon.png",
    "32": "assets/images/logo_icon.png",
    "48": "assets/images/logo_icon.png",
    "128": "assets/images/logo_icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/utils/storageManager.js"],
      "matches": [
        "*://codeforces.com/*", 
        "*://*.codeforces.com/*", 
        "*://atcoder.jp/*",
        "*://leetcode.com/*",
        "*://*.leetcode.com/*",
        "*://hackerrank.com/*",
        "*://*.hackerrank.com/*",
        "*://kaggle.com/*",
        "*://*.kaggle.com/*",
        "*://geeksforgeeks.org/*",
        "*://*.geeksforgeeks.org/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Constellation",
    "default_icon": {
      "16": "assets/images/logo_icon.png",
      "32": "assets/images/logo_icon.png",
      "48": "assets/images/logo_icon.png",
      "128": "assets/images/logo_icon.png"
    }
  }
}
