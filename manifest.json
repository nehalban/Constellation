{
  "manifest_version": 3,
  "name": "Constellation",
  "version": "2.0",
  "description": "Add personal notes to Codeforces and AtCoder friends. Visible everywhere, synced across devices.",
  "permissions": [ "storage" ],
  "content_scripts": [
    {
      "matches": [ 
        "*://codeforces.com/*", 
        "*://*.codeforces.com/*", 
        "*://atcoder.jp/*" 
      ],
      "js": [ "content.js" ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "logo_icon.png",
    "32": "logo_icon.png",
    "48": "logo_icon.png",
    "128": "logo_icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["storageManager.js"],
      "matches": ["*://codeforces.com/*", "*://*.codeforces.com/*", "*://atcoder.jp/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Constellation",
    "default_icon": {
      "16": "logo_icon.png",
      "32": "logo_icon.png",
      "48": "logo_icon.png",
      "128": "logo_icon.png"
    }
  }
}
